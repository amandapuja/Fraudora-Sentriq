# ── Database ──────────────────────────────────────────────────────────────
POSTGRES_DB=trustlens
POSTGRES_USER=trustlens
POSTGRES_PASSWORD=trustlens_password

# ── Neo4j ─────────────────────────────────────────────────────────────────
NEO4J_USER=neo4j
NEO4J_PASSWORD=trustlens_neo4j_password
NEO4J_PLUGINS=[]

# ── Backend (dibaca lewat backend/.env oleh docker-entrypoint, salin dari backend/.env.example) ──
JWT_SECRET_KEY=change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTO_MIGRATE=true
AUTO_SEED=true

# Origin yang diizinkan CORS untuk mengakses backend (frontend Vite default 8443)
BACKEND_CORS_ORIGINS=http://localhost:8443,http://localhost:5173,http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────────────
VITE_API_URL=/api/v1
# Target proxy di dalam network Docker; biasanya tidak perlu diubah
VITE_PROXY_TARGET=http://backend:8000

# ── Port host (opsional, override jika bentrok) ──────────────────────────
HOST_POSTGRES_PORT=5432
HOST_NEO4J_HTTP_PORT=7474
HOST_NEO4J_BOLT_PORT=7687
HOST_BACKEND_PORT=8000
HOST_FRONTEND_PORT=8443
