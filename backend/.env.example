PROJECT_NAME=TrustLens API
API_VERSION=v1

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trustlens
POSTGRES_USER=trustlens
POSTGRES_PASSWORD=trustlens

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=trustlens123

JWT_SECRET_KEY=change-this-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Origin frontend Vite (alibaba_fiks). Tambahkan origin lain dipisah koma jika perlu.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8443,http://127.0.0.1:8443,http://localhost:3000,http://localhost:4173

ADAPTIVE_RETRAIN_MIN_LABELS=5
ADAPTIVE_RETRAIN_LIMIT_ROWS=200000
# Startup otomatis (Docker)
AUTO_MIGRATE=true
AUTO_SEED=true
